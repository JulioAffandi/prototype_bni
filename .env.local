# =====================================================
# VALO Education Ecosystem — Local Development ENV
# Copy this to .env.local and fill in real values
# DO NOT commit .env.local to git
# =====================================================

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# OpenAI (required for AI Advisor features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# NFC Simulator — set to 'true' for local development/demo
NEXT_PUBLIC_NFC_SIMULATOR_ENABLED=true

# BNI H2H SNAP BI (fill in for payment integration testing)
BNI_H2H_CLIENT_KEY=your-bni-client-key
BNI_H2H_CLIENT_SECRET=your-bni-client-secret
BNI_H2H_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
BNI_H2H_BASE_URL=https://apidev.bni.co.id

# Per-tenant NFC UID tokenization salt (must be at least 32 chars)
TENANT_SALT_SECRET=dev-only-salt-replace-in-production-123

# WhatsApp notifications (optional for dev)
# FONNTE_API_TOKEN=your-fonnte-token
