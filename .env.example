NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

OPENAI_API_KEY=sk-your-openai-api-key

# NFC Simulator — set to 'false' in production (§2.3)
NEXT_PUBLIC_NFC_SIMULATOR_ENABLED=true

# BNI H2H SNAP BI Integration (§9.1, §11.3)
BNI_H2H_CLIENT_KEY=your-bni-client-key
BNI_H2H_CLIENT_SECRET=your-bni-client-secret
BNI_H2H_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
BNI_H2H_BASE_URL=https://apidev.bni.co.id

# Per-tenant salt for NFC UID tokenization — stored in secret manager (§11.2)
# NEVER stored in the same database. Rotate only via key-migration procedure.
TENANT_SALT_SECRET=your-32-char-random-secret-here
